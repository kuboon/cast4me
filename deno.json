{
  "workspace": [
    "./web/client",
    "./web/server"
  ],
  "tasks": {
    "dev": "deno task --cwd web/server dev",
    "serve": "deno task --cwd web/server serve",
    "test": "deno test -P",
    "check": "deno task --cwd web/client check && deno task --cwd web/server check && deno lint && deno fmt --check"
  },
  "permissions": {
    "default": {
      "read": true,
      "write": true,
      "env": true,
      "net": [
        "localhost",
        "127.0.0.1"
      ],
      "import": true
    }
  },
  "test": {
    "permissions": "default"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@kuboon/*",
      "jsr:@remix-kbn/*",
      "npm:@remix-run/*"
    ]
  },
  "unstable": [
    "bundle",
    "kv"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  },
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^1.1.0",
    "@remix-kbn/assets-deno": "jsr:@remix-kbn/assets-deno@^0.9.0",
    "@remix-kbn/ssg": "jsr:@remix-kbn/ssg@^0.13.0",
    "@remix-run/component": "npm:@remix-run/component@^1.0.0",
    "@remix-run/cop-middleware": "npm:@remix-run/cop-middleware@^1.0.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^1.0.0",
    "@remix-run/render-middleware": "npm:@remix-run/render-middleware@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/ulid": "jsr:@std/ulid@^1.0.0"
  },
  "fmt": {
    "exclude": [
      "data",
      "web/server/data",
      "node_modules"
    ]
  },
  "lint": {
    "exclude": [
      "data",
      "web/server/data",
      "node_modules"
    ]
  }
}
