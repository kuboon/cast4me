{
  "tasks": {
    "dev": "deno serve -P=serve --watch --port 8000 router.tsx",
    "serve": "deno serve -P=serve --port 8000 router.tsx",
    "check": "deno check ."
  },
  "permissions": {
    "serve": {
      "read": true,
      "write": true,
      "env": true,
      "net": true,
      "run": true,
      "import": true
    }
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  }
}
